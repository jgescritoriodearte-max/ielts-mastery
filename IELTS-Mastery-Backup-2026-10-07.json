:tenses:4","c":0,"w":1,"last":1791057814411,"lastOk":false,"updatedAt":1791057814411},{"id":"pp:PP-034","c":0,"w":1,"last":1791403155512,"lastOk":false,"updatedAt":1791403155512},{"id":"pp:PP-035","c":0,"w":1,"last":1791403155512,"lastOk":false,"updatedAt":1791403155512},{"id":"pp:PP-040","c":0,"w":1,"last":1791403155512,"lastOk":false,"updatedAt":1791403155512},{"id":"pp:PP-042","c":0,"w":1,"last":1791403155512,"lastOk":false,"updatedAt":1791403155512},{"id":"pp:PP-045","c":1,"w":0,"last":1791403155512,"lastOk":true,"updatedAt":1791403155512},{"id":"pp:PP-046","c":0,"w":1,"last":1791403155512,"lastOk":false,"updatedAt":1791403155512},{"id":"pp:PP-047","c":1,"w":0,"last":1791403155512,"lastOk":true,"updatedAt":1791403155512},{"id":"pp:PP-048","c":0,"w":1,"last":1791403155512,"lastOk":false,"updatedAt":1791403155512},{"id":"pp:PP-053","c":1,"w":0,"last":1791403155512,"lastOk":true,"updatedAt":1791403155512},{"id":"pp:PP-055","c":1,"w":0,"last":1791403155512,"lastOk":true,"updatedAt":1791403155512}],"mistakes":[{"id":"m-mustkubvyblbdj","updatedAt":1791057814411,"ts":1791057814411,"skill":"G","ref":"tenses","qid":"g:tenses:4","qtype":"Tenses","tag":"Tenses","difficulty":"Level 3","prompt":"While the proportion of cars ___ steadily, the use of bicycles fluctuated.","your":"has risen","correct":"was rising","explanation":"Two simultaneous past trends: the background trend takes the past continuous. Natural: While car use was rising steadily, cycling fluctuated.","resolved":false,"reviewOk":0,"reviewCount":0},{"id":"m-mustoswd60qutm","updatedAt":1791057999181,"ts":1791057999181,"skill":"G","ref":"present-perfect","qid":"g:present-perfect:4","qtype":"Present Perfect","tag":"Present Perfect","difficulty":"Level 3","prompt":"This is the first time I ___ an IELTS mock test.","your":"am taking","correct":"have taken","explanation":"'This is the first time' is always followed by the present perfect. Natural: This is the first time I have taken an IELTS mock test.","resolved":false,"reviewOk":0,"reviewCount":0},{"id":"m-mustoswdxgrjjo","updatedAt":1791057999181,"ts":1791057999181,"skill":"G","ref":"present-perfect","qid":"g:present-perfect:1","qtype":"Present Perfect","tag":"Present Perfect","difficulty":"Level 1","prompt":"She ___ the report two days ago.","your":"has been finishing","correct":"finished","explanation":"'Ago' marks a finished time, so the past simple is needed. Natural: She finished the report two days ago.","resolved":false,"reviewOk":0,"reviewCount":0},{"id":"m-mustsd7g8gapo4","updatedAt":1791058165468,"ts":1791058165468,"skill":"G","ref":"articles","qid":"g:articles:4","qtype":"Articles","tag":"Articles","difficulty":"Level 3","prompt":"___ number of students studying abroad has risen, but ___ number of them return home.","your":"The / the","correct":"The / a","explanation":"'The number of' refers to the total quantity and takes a singular verb ('has risen'). 'A number of' means 'several' and takes a plural verb ('return'). Natural: The number of students studying abroad has risen, but a number of them return home.","resolved":false,"reviewOk":0,"reviewCount":0},{"id":"m-mustsd7ga27jis","updatedAt":1791058165468,"ts":1791058165468,"skill":"G","ref":"articles","qid":"g:articles:3","qtype":"Articles","tag":"Articles","difficulty":"Level 2","prompt":"Many people believe that ___ children should learn a second language.","your":"the","correct":"(no article)","explanation":"Children in general (plural, general) take no article. Natural: Many people believe that children should learn a second language.","resolved":false,"reviewOk":0,"reviewCount":0},{"id":"m-mustsd7gzkrb8d","updatedAt":1791058165468,"ts":1791058165468,"skill":"G","ref":"articles","qid":"g:articles:1","qtype":"Articles","tag":"Articles","difficulty":"Level 1","prompt":"She is ___ honest person.","your":"a","correct":"an","explanation":"'Honest' starts with a vowel sound (the h is silent). Natural: She is an honest person.","resolved":false,"reviewOk":0,"reviewCount":0},{"id":"m-mustwflz3we197","updatedAt":1791058355207,"ts":1791058355207,"skill":"G","ref":"prepositions","qid":"g:prepositions:4","qtype":"Prepositions","tag":"Prepositions","difficulty":"Level 3","prompt":"Excessive screen time can contribute ___ poor sleep.","your":"for","correct":"to","explanation":"'Contribute to' is the fixed collocation. Natural: Excessive screen time can contribute to poor sleep.","resolved":false,"reviewOk":0,"reviewCount":0},{"id":"m-mustwflz9ksvf9","updatedAt":1791058355207,"ts":1791058355207,"skill":"G","ref":"prepositions","qid":"g:prepositions:1","qtype":"Prepositions","tag":"Prepositions","difficulty":"Level 1","prompt":"It depends ___ the situation.","your":"of","correct":"on","explanation":"'Depend on' is fixed. 'Depend of' is a direct translation of 'depender de'. Natural: It depends on the situation.","resolved":false,"reviewOk":0,"reviewCount":0},{"id":"m-muyie4f66y5uy7","updatedAt":1791401822178,"ts":1791401822178,"skill":"L","ref":"L5","qid":"L5:0:3","qtype":"Form Completion","tag":"no answer","difficulty":"Level 1 · 5.5","prompt":"Phone: ___","your":"(blank)","correct":"01614960732","explanation":"'Oh' = zero. Spaces do not matter.","resolved":false,"reviewOk":0,"reviewCount":0},{"id":"m-muyie4f686echn","updatedAt":1791401822178,"ts":1791401822178,"skill":"L","ref":"L5","qid":"L5:0:2","qtype":"Form Completion","tag":"spelling","difficulty":"Level 1 · 5.5","prompt":"Surname: ___","your":"emoshe","correct":"penrose","explanation":"Names spelled letter by letter must be written exactly.","resolved":false,"reviewOk":0,"reviewCount":0},{"id":"m-muyie4f6e81gzi","updatedAt":1791401822178,"ts":1791401822178,"skill":"L","ref":"L5","qid":"L5:0:1","qtype":"Form Completion","tag":"spelling","difficulty":"Level 1 · 5.5","prompt":"Time: ___ pm","your":"7.5","correct":"7.30","explanation":"Eight o'clock was not available; she accepts half past seven = 7.30.","resolved":false,"reviewOk":0,"reviewCount":0},{"id":"m-muyijxtl1behfm","updatedAt":1791402093560,"ts":1791402093560,"skill":"L","ref":"LP1-01","qid":"LP1-01:2:1","qtype":"Note Completion","tag":"detail","difficulty":"Level 1 · 5.5","prompt":"Must wear ___ during the induction","your":"shoews","correct":"trainers","explanation":"The trainer will not allow ordinary shoes on the machines, so trainers are required.","resolved":false,"reviewOk":0,"reviewCount":0},{"id":"m-muyijxtl4o0yar","updatedAt":1791402093560,"ts":1791402093560,"skill":"L","ref":"LP1-01","qid":"LP1-01:0:0","qtype":"Form Completion","tag":"spelling","difficulty":"Level 1 · 5.5","prompt":"Surname: ___","your":"whap","correct":"Whitcombe","explanation":"Write the surname exactly as it is spelled letter by letter. A misspelled name is marked wrong in IELTS.","resolved":false,"reviewOk":0,"reviewCount":0},{"id":"m-muyijxtl5jftrw","updatedAt":1791402093560,"ts":1791402093560,"skill":"L","ref":"LP1-01","qid":"LP1-01:0:2","qtype":"Form Completion","tag":"distractors","difficulty":"Level 1 · 5.5","prompt":"Mobile number: ___","your":"07710261","correct":"07700900261","explanation":"He first says 'three six one', then corrects himself to 'two six one'. The corrected number is always the answer. 'Oh' means zero.","resolved":false,"reviewOk":0,"reviewCount":0},{"id":"m-muyijxtl9vczzf","updatedAt":1791402093560,"ts":1791402093560,"skill":"L","ref":"LP1-01","qid":"LP1-01:2:0","qtype":"Note Completion","tag":"no answer","difficulty":"Level 1 · 5.5","prompt":"Gym induction: Thursday at ___ pm","your":"(blank)","correct":"6.30","explanation":"'Half past six' in the evening is 6.30 pm. Do not confuse the time with the date (the twenty-fourth).","resolved":false,"reviewOk":0,"reviewCount":0},{"id":"m-muyijxtlofl6xj","updatedAt":1791402093560,"ts":1791402093560,"skill":"L","ref":"LP1-01","qid":"LP1-01:0:3","qtype":"Form Completion","tag":"numbers","difficulty":"Level 1 · 5.5","prompt":"Monthly fee: £___","your":"24","correct":"32","explanation":"He chooses the standard membership, which costs £32. £24 (off-peak) and £45 (premium) are other memberships he does not choose.","resolved":false,"reviewOk":0,"reviewCount":0},{"id":"m-muyijxtlsac5iq","updatedAt":1791402093560,"ts":1791402093560,"skill":"L","ref":"LP1-01","qid":"LP1-01:0:1","qtype":"Form Completion","tag":"spelling","difficulty":"Level 1 · 5.5","prompt":"Address: 42 ___ Road","your":"malin","correct":"Marley","explanation":"Street names are often spelled out in Part 1. Listen for each letter: M-A-R-L-E-Y.","resolved":false,"reviewOk":0,"reviewCount":0},{"id":"m-muyip4qu8kopmv","updatedAt":1791402335814,"ts":1791402335814,"skill":"G","ref":"conditionals","qid":"g:conditionals:4","qtype":"Conditionals","tag":"Conditionals","difficulty":"Level 3","prompt":"___ more funding available, the museum could extend its opening hours.","your":"If there is","correct":"Were there","explanation":"Inversion 'Were there…' = 'If there were…', a formal second conditional. Natural: Were there more funding available, the museum could extend its opening hours.","resolved":false,"reviewOk":0,"reviewCount":0},{"id":"m-muyirrzw5foqk6","updatedAt":1791402459260,"ts":1791402459260,"skill":"G","ref":"passive","qid":"g:passive:3","qtype":"Passive Voice","tag":"Passive Voice","difficulty":"Level 2","prompt":"It ___ that the economy will recover.","your":"is expecting","correct":"is expected","explanation":"Impersonal passive 'It is expected that…' is formal and common in Task 2. Natural: It is expected that the economy will recover.","resolved":false,"reviewOk":0,"reviewCount":0},{"id":"m-muyivh3tn3vgn4","updatedAt":1791402631769,"ts":1791402631769,"skill":"G","ref":"relative","qid":"g:relative:3","qtype":"Relative Clauses","tag":"Relative Clauses","difficulty":"Level 2","prompt":"Artists ___ work is sold at auction can become famous quickly.","your":"who","correct":"whose","explanation":"Possession (their work) = whose. Natural: Artists whose work is sold at auction can become famous quickly.","resolved":false,"reviewOk":0,"reviewCount":0},{"id":"m-muyj6p883gv2xu","updatedAt":1791403155512,"ts":1791403155512,"skill":"P","ref":"paraphrase","qid":"pp:PP-046","qtype":"Grammatical transformation","tag":"Grammatical transformation","difficulty":"5.5","prompt":"My brother is a better cook than me. → I can't cook as ___ my brother.","your":"same as","correct":"well as","explanation":"Grammar: comparative adjective (a better cook) -> 'not as + adverb + as' (can't cook as well as).","resolved":false,"reviewOk":0,"reviewCount":0},{"id":"m-muyj6p885i1nq6","updatedAt":1791403155512,"ts":1791403155512,"skill":"P","ref":"paraphrase","qid":"pp:PP-042","qtype":"Grammatical transformation","tag":"Grammatical transformation","difficulty":"6","prompt":"It's possible that the meeting will be cancelled. → The meeting ___ cancelled.","your":"has be","correct":"might be","explanation":"Grammar: 'it's possible that ... will' = modal of possibility 'might / may / could' + passive infinitive. 'Will be' or 'must be' would make it too certain.","resolved":false,"reviewOk":0,"reviewCount":0},{"id":"m-muyj6p88an1bun","updatedAt":1791403155512,"ts":1791403155512,"skill":"P","ref":"paraphrase","qid":"pp:PP-048","qtype":"Grammatical transformation","tag":"Grammatical transformation","difficulty":"6.5","prompt":"It was wrong of the company to ignore the safety warnings. → The company ___ ignored the safety warnings.","your":"have","correct":"shouldn't have","explanation":"Grammar: criticism of a past action 'it was wrong to' = 'should not have + past participle'.","resolved":false,"reviewOk":0,"reviewCount":0},{"id":"m-muyj6p88pkpj8z","updatedAt":1791403155512,"ts":1791403155512,"skill":"P","ref":"paraphrase","qid":"pp:PP-040","qtype":"Grammatical transformation","tag":"Grammatical transformation","difficulty":"7.5","prompt":"We didn't leave early, so we missed the last ferry. → If we ___ early, we wouldn't have missed the last ferry.","your":"leaved","correct":"had left","explanation":"Grammar: past facts -> third conditional (if + past perfect, would have + past participle). The negative fact 'didn't leave' becomes the positive hypothetical 'had left'.","resolved":false,"reviewOk":0,"reviewCount":0},{"id":"m-muyj6p88rgs5gw","updatedAt":1791403155512,"ts":1791403155512,"skill":"P","ref":"paraphrase","qid":"pp:PP-034","qtype":"Grammatical transformation","tag":"Grammatical transformation","difficulty":"7","prompt":"The box was so heavy that nobody could lift it. → The box was ___ for anyone to lift.","your":"heavet","correct":"too heavy","explanation":"Grammar: 'so + adjective + that ... could not' = 'too + adjective + for ... to'. Note the negative disappears because 'too' already carries it.","resolved":false,"reviewOk":0,"reviewCount":0},{"id":"m-muyj6p88z2l7is","updatedAt":1791403155512,"ts":1791403155512,"skill":"P","ref":"paraphrase","qid":"pp:PP-035","qtype":"Grammatical transformation","tag":"Grammatical transformation","difficulty":"7.5","prompt":"As the population ages, the demand for healthcare increases. → Which sentence has the SAME meaning?","your":"The population is ageing because demand for healthcare is increasing.","correct":"The older the population becomes, the greater the demand for healthcare.","explanation":"Grammar: proportional 'as ... , ...' -> 'the + comparative ..., the + comparative'. Option 2 reverses the effect; options 3 and 4 reverse cause and effect.","resolved":false,"reviewOk":0,"reviewCount":0},{"id":"m-muyjc94j1ttles","updatedAt":1791403414579,"ts":1791403414579,"skill":"L","ref":"LP1-02","qid":"LP1-02:2:1","qtype":"Short Answer","tag":"numbers","difficulty":"Level 1 · 5.5","prompt":"How much is the fee for collecting an item?","your":"3 months","correct":"£3.50","explanation":"'Handling fee' = the fee for collecting. Three pounds fifty is written £3.50.","resolved":false,"reviewOk":0,"reviewCount":0},{"id":"m-muyjc94j4shmrk","updatedAt":1791403414579,"ts":1791403414579,"skill":"L","ref":"LP1-02","qid":"LP1-02:0:0","qtype":"Form Completion","tag":"spelling","difficulty":"Level 1 · 5.5","prompt":"Name: Mark ___","your":"deamin","correct":"Adeyemi","explanation":"Names from other languages are always spelled in the recording. Write each letter in order.","resolved":false,"reviewOk":0,"reviewCount":0},{"id":"m-muyjc94j8t5stu","updatedAt":1791403414579,"ts":1791403414579,"skill":"L","ref":"LP1-02","qid":"LP1-02:0:3","qtype":"Form Completion","tag":"detail","difficulty":"Level 1 · 5.5","prompt":"Type of bag: ___","your":"seat","correct":"rucksack","explanation":"A rucksack is a bag carried on the back. 'Medium-sized' describes its size, not its type.","resolved":false,"reviewOk":0,"reviewCount":0},{"id":"m-muyjc94jdgwe63","updatedAt":1791403414579,"ts":1791403414579,"skill":"L","ref":"LP1-02","qid":"LP1-02:0:6","qtype":"Form Completion","tag":"spelling","difficulty":"Level 1 · 5.5","prompt":"Contact number: ___","your":"0134960982","correct":"01134960582","explanation":"Write all the digits; 'oh' = 0. This is his office number, which he prefers because his mobile battery keeps dying.","resolved":false,"reviewOk":0,"reviewCount":0},{"id":"m-muyjc94jrux5sb","updatedAt":1791403414579,"ts":1791403414579,"skill":"L","ref":"LP1-02","qid":"LP1-02:0:4","qtype":"Form Completion","tag":"spelling","difficulty":"Level 1 · 5.5","prompt":"Colour: ___","your":"nave blue","correct":"navy blue","explanation":"Black is mentioned only because some people think the bag looks black. The real colour is navy blue.","resolved":false,"reviewOk":0,"reviewCount":0},{"id":"m-muyjc94jwj7ebd","updatedAt":1791403414579,"ts":1791403414579,"skill":"L","ref":"LP1-02","qid":"LP1-02:0:5","qtype":"Form Completion","tag":"detail","difficulty":"Level 1 · 5.5","prompt":"Identifying feature: yellow ___ on front pocket","your":"label","correct":"luggage tag","explanation":"'Makes it easy to recognise' is paraphrased in the form as 'identifying feature'. The tag is yellow.","resolved":false,"reviewOk":0,"reviewCount":0}],"vocab":[{"id":"Environment:bi