ts must to be discuss in the internal politics by each institution. The museum most to evaluate the operational coust incidence, the gross and the net to understand if that programs will attend the people target without compromise the revenue. The museum constantly must to promote the exibitions and try to atract the must big number os people visiting. ","secs":812,"status":"submitted","submittedAt":1791059461231}],"recordings":[{"id":"r-musutd0cvy6rf2","updatedAt":1791059891484,"createdAt":1791059891484,"part":2,"topic":"C1","question":"Describe a museum or gallery you enjoyed visiting.","durSecs":120.225,"mime":"audio/webm;codecs=opus","size":1936984,"transcript":"","audioOmitted":true}],"sessions":[{"id":"2026-10-03|dmustkuc3vzkfwn","minutes":16.1,"items":21,"updatedAt":1791059891495},{"id":"2026-10-07|dmustkuc3vzkfwn","minutes":22.6,"items":51,"updatedAt":1791403414591}],"mocks":[],"external":[],"customPacks":[]}}